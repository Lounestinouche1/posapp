<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VectronTablet.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:VectronTablet"
    xmlns:pages="clr-namespace:VectronTablet.Pages"
    Title="Vectron Waiter"
    Shell.BackgroundColor="{StaticResource Bg}"
    Shell.ForegroundColor="{StaticResource Txt}"
    Shell.TitleColor="{StaticResource Txt}"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Tables"
        ContentTemplate="{DataTemplate pages:TablesPage}"
        Route="main" />

</Shell>
