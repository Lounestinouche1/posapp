<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VectronTablet.Pages.AlertsPage"
             BackgroundColor="{StaticResource Bg}">

    <Grid RowDefinitions="Auto,*" Padding="14,44,14,10">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <!-- P1.5: no Clicked — the clicks travel through Theme.PressBind (code-behind). -->
            <Button x:Name="backBtn" Text="←" Style="{StaticResource GhostBtn}" WidthRequest="48" />
            <Label Grid.Column="1" Text="Notifications" Style="{StaticResource SectionLbl}"
                   VerticalOptions="Center" />
            <Button Grid.Column="2" x:Name="clearBtn" Text="Clear all" Style="{StaticResource GhostBtn}" />
        </Grid>

        <RefreshView Grid.Row="1" Refreshing="OnRefresh">
            <ScrollView>
                <VerticalStackLayout x:Name="list" Padding="0,12,0,20" Spacing="8" />
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
